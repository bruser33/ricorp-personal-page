PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/pagina_personal
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://bruser33.github.io

# Envío de correo del formulario de contacto (Resend).
# Sin RESEND_API_KEY el endpoint corre en modo dry-run: loguea el envío y responde
# { ok: true, dryRun: true } sin mandar nada. NUNCA commitear una key real.
RESEND_API_KEY=
CONTACT_TO=pedro.luis.rico43@gmail.com
# Remitente: tiene que ser un dominio verificado en Resend.
# `onboarding@resend.dev` funciona sin verificar, pero solo entrega al dueño de la cuenta.
CONTACT_FROM=RICORP <onboarding@resend.dev>

# ─── Agenda y cuentas de WS Style (SPEC-32) ─────────────────────────────────
# Mongo como REPLICA SET de un nodo (las reservas usan transacciones):
#   mongod --replSet rs0 --port 27017 --dbpath <dir>  +  mongosh --eval 'rs.initiate()'
#   MONGO_URI=mongodb://localhost:27017/pagina_personal?replicaSet=rs0
# Tests (`npm test`): BD real separada, nunca la de desarrollo.
MONGO_TEST_URI=mongodb://localhost:27017/wstyle_test?replicaSet=rs0
# URL pública del front (links de los correos y vuelta de Facebook). Local: el MISMO host
# que la API (localhost con localhost; 127.0.0.1 es otro sitio y la cookie no viaja).
FRONT_URL=http://localhost:5173
# Firma del `state` de OAuth. Cualquier texto largo y aleatorio.
AUTH_SECRET=
# 1 = no envía correos de la agenda (los loguea). Útil en desarrollo aunque haya RESEND_API_KEY.
MAIL_DRY_RUN=
MAIL_FROM=WS Style <onboarding@resend.dev>
# Buzón local para desarrollo (tutorial SPEC-36): Mailpit/MailHog reciben por SMTP sin auth y
# muestran los correos en su web. Con SMTP_HOST los correos de la agenda van ahí en vez del
# dry-run. Prioridad: RESEND_API_KEY → SMTP_HOST → SMTP_USER/SMTP_PASS (Gmail) → dry-run;
# MAIL_DRY_RUN=1 gana a todo. Ejemplo con Mailpit (brew install mailpit && mailpit):
#   SMTP_HOST=localhost  SMTP_PORT=1025  → bandeja en http://localhost:8025
# (si el buzón pide auth, se usan SMTP_USER/SMTP_PASS). No afecta a /api/contact.
SMTP_HOST=
SMTP_PORT=
# Cookie de sesión: en producción COOKIE_SECURE=1. Si la API NO está en un subdominio
# propio (api.ricorp.cl) sino en *.onrender.com, hace falta COOKIE_SAMESITE=None (cookie de
# terceros: Safari la bloquea). Recomendado: api.ricorp.cl + SameSite=Lax.
COOKIE_SECURE=
COOKIE_SAMESITE=Lax

# Facebook Login (RN-24 de SPEC-32 y registro de barberos de SPEC-33). App de Meta en modo
# desarrollo: solo administradores/testers. Sin estas tres variables el botón "Continuar con
# Facebook" no aparece (ni en /wstyle/cuenta/ ni en /wstyle/pro/registro/).
# Pasos: developers.facebook.com → Crear app (tipo "Consumidor", cuenta PERSONAL) → producto
# "Inicio de sesión con Facebook" → "URI de redireccionamiento de OAuth válidos" = FB_REDIRECT_URI
# (local: http://localhost:4000/api/auth/facebook/callback, o el PORT que uses) → Roles → Testers
# (agrega la cuenta de prueba) → Configuración básica: copia el identificador y la clave secreta.
FB_APP_ID=
FB_APP_SECRET=
FB_REDIRECT_URI=http://localhost:4000/api/auth/facebook/callback

# Login con Google (SPEC-38). OAuth 2.0 + OpenID Connect en el server (scopes openid email profile).
# Sin estas tres variables el botón "Continuar con Google" no aparece y /api/auth/google/start
# vuelve con ?gg=no_disponible. El secreto NUNCA va al client ni al repo.
# Pasos (cuenta PERSONAL de Google, nunca una de trabajo):
#  1. https://console.cloud.google.com → crear proyecto "WS Style".
#  2. "APIs y servicios" → "Pantalla de consentimiento de OAuth": tipo Externo, nombre WS Style,
#     correo de soporte, dominio ricorp.cl, Política de privacidad https://ricorp.cl/wstyle/privacidad/
#     y Términos https://ricorp.cl/wstyle/terminos/. Scopes: openid, email, profile (no requieren
#     revisión de seguridad). Mientras esté en "Testing" solo entran los usuarios de prueba agregados.
#  3. "Credenciales" → "Crear credenciales" → "ID de cliente de OAuth" → tipo "Aplicación web".
#     URIs de redireccionamiento autorizados:
#       local: http://localhost:4000/api/auth/google/callback   (o el PORT que uses)
#       prod:  https://api.ricorp.cl/api/auth/google/callback
#  4. Copia el ID de cliente y el secreto aquí. GOOGLE_REDIRECT_URI tiene que ser EXACTAMENTE uno de
#     los URIs autorizados.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Mercado Pago Checkout Pro (SPEC-35). NUNCA se leen ni se escriben desde el panel: solo viven acá
# (y en Render como variables `sync: false`). El panel (/wstyle/admin/configuracion/) muestra si
# están cargadas y el modo: un token que empieza con TEST- = sandbox; APP_USR- = producción.
# Sin MP_ACCESS_TOKEN "Pagar en línea" no aparece en la reserva aunque el admin lo habilite.
#
# Cómo cargarlas (cuenta PERSONAL de Mercado Pago Chile, nunca una cuenta de trabajo):
#  1. https://www.mercadopago.cl/developers/panel/app → "Crear aplicación" → producto Checkout Pro.
#  2. En la aplicación → "Cuentas de prueba": crea un usuario VENDEDOR y uno COMPRADOR (país Chile).
#  3. Entra a Developers con el vendedor de prueba → su aplicación → credenciales del usuario de
#     prueba → copia el Access Token aquí.
#  4. "Webhooks" (Notificaciones) → modo prueba → URL = <túnel>/api/payments/mp/webhook, evento
#     "Pagos" → guarda y copia la "Clave secreta" a MP_WEBHOOK_SECRET.
#  5. Túnel local (Mercado Pago no llega a localhost):
#       cloudflared tunnel --url http://localhost:4000   (o: ngrok http 4000)
#     y pon esa URL https en MP_NOTIFICATION_URL (con la ruta /api/payments/mp/webhook).
#  6. Reinicia el server (npm run dev) y habilita "Pagar en línea" en el panel → Configuración.
#  Sin túnel también funciona: la página de la cita y la conciliación (cada 5 min) consultan a
#  Mercado Pago por la referencia de la cita.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# URL completa del webhook (opcional). Si no está: API_PUBLIC_URL + /api/payments/mp/webhook.
# Solo se envía a Mercado Pago si es https (localhost no sirve).
MP_NOTIFICATION_URL=
# Front público para las back_urls del checkout (vuelta a /wstyle/cita/?id=…). Default: FRONT_URL.
# Con http (localhost) no se envía auto_return: Mercado Pago lo exige con https; el comprador
# vuelve con el botón "Volver al sitio".
PUBLIC_SITE_URL=http://localhost:5173
# URL pública de esta API (producción: la de Render o api.ricorp.cl).
API_PUBLIC_URL=

# Super admin (SPEC-34 RN-01). Al arrancar (o con `npm run seed:admin`), si NO existe ningún
# super admin se crea uno con este correo y contraseña (hasheada; mínimo 8 caracteres con letras
# y números). Si ya existe uno, no se crea otro ni se cambia su contraseña. Sin estas variables
# no se crea nada y /wstyle/admin/ muestra "Panel no configurado".
# SUPERADMIN_EMAIL también recibe los avisos "Nuevo barbero por aprobar" (varios separados por
# coma; la cuenta se crea con el primero). Cambia la contraseña en el panel después del 1.er ingreso.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# ─── Respaldo tributario y rendición (SPEC-37). VALIDAR CON UN CONTADOR antes de producción.
# Modelo de emisión declarado en el SII (TaxDocumentProvider):
#   voucher → "No emito boleta cuando recibo un pago electrónico" (Res. SII 176/2020): el voucher de
#             Mercado Pago ES la boleta; los cobros en el local llevan boleta manual (app/portal del SII)
#             y se registra su N° en el panel. Es el default y no tiene costo extra.
#   manual  → "Siempre emito boleta": toda venta (también las de MP) lleva el N° de la boleta manual.
# Cambiarlo rige desde el reinicio; la rendición del mes muestra los dos tramos.
SII_TAX_PROVIDER=voucher
# Emisor (persona natural, primera categoría). Sin RUT el panel muestra "Emisor pendiente" y los
# montos de neto/IVA como estimados. El RUT NUNCA sale del server (ni por la API ni en los logs):
# solo va acá y en Render como variable `sync: false`. NUNCA commitear un RUT real.
SII_EMITTER_NAME=
SII_EMITTER_RUT=

# ─── Avisos por WhatsApp (SPEC-53): WhatsApp Business Platform – Cloud API de Meta ──────────
# API OFICIAL con plantillas aprobadas. Nada de WhatsApp Web ni librerías no oficiales (el número
# puede quedar bloqueado). Los secretos NUNCA se leen ni se escriben desde el panel: solo viven acá
# (y en Render como `sync: false`). NUNCA commitear valores reales.
# Sin WHATSAPP_TOKEN o WHATSAPP_PHONE_NUMBER_ID (o con WHATSAPP_DRY_RUN=1) todo funciona igual
# (opt-in, cola, panel "Mensajes"), pero nada sale hacia Meta: los mensajes quedan "Simulados" y se
# loguea `[wa] dry-run → +569****5678 · ws_cita_recordatorio`.
#
# Cómo cargarlas (cuenta de Meta de WS Style/Joe o personal de bruser33; NUNCA una de trabajo):
#  1. https://business.facebook.com → crear (o usar) el portafolio comercial de WS Style.
#  2. https://developers.facebook.com/apps → Crear app → tipo "Empresa" → agregar el producto
#     "WhatsApp" y asociarla al portafolio. Eso crea la cuenta de WhatsApp Business (WABA).
#  3. WhatsApp → Configuración de la API → "Agregar número de teléfono": un número DEDICADO de WS
#     Style (deja de funcionar en la app de WhatsApp del celular, salvo la "coexistencia" con la app
#     WhatsApp Business). Copia el "Identificador del número de teléfono" (WHATSAPP_PHONE_NUMBER_ID)
#     y el "Identificador de la cuenta de WhatsApp Business" (WHATSAPP_BUSINESS_ACCOUNT_ID).
#  4. Token PERMANENTE: portafolio → Configuración del negocio → Usuarios del sistema → crear uno
#     (Administrador) → Asignar activos: la app y la WABA (control total) → "Generar token" con los
#     permisos whatsapp_business_messaging y whatsapp_business_management, sin vencimiento.
#     (El token temporal de 24 h de la pantalla de prueba NO sirve para producción.)
#  5. App → Configuración → Básica → "Clave secreta de la app" → WHATSAPP_APP_SECRET.
#  6. WhatsApp → Configuración → Webhook: URL de devolución de llamada
#       https://api.ricorp.cl/api/whatsapp/webhook   (local: un túnel, p.ej. cloudflared/ngrok)
#     Token de verificación = WHATSAPP_VERIFY_TOKEN (cualquier texto largo y aleatorio que inventes).
#     Suscribe el campo "messages" (trae los estados enviado/entregado/leído/fallido y las respuestas).
#  7. WhatsApp Manager → Plantillas de mensajes → crear DOS plantillas, categoría "Utilidad",
#     idioma Español (es), y esperar a que queden "Aprobadas". Los nombres y el ORDEN de las
#     variables son fijos (el código depende de ellos; el texto puede ajustarse a lo que apruebe Meta):
#     ws_cita_confirmada
#       Cuerpo: Hola {{1}}, tu hora en WS Style quedó confirmada: {{2}} con {{3}}, el {{4}} a las {{5}}.
#               Si no puedes venir, avísanos desde el link para dárselo a otra persona.
#       Pie:    Este número solo envía avisos. Para hablar con nosotros escribe al <wa.me del local>
#       Botón:  "Visitar sitio web" → URL dinámica  https://ricorp.cl/wstyle/cita/?{{1}}
#               (ejemplo para la revisión: id=000000000000000000000000&t=ejemplo)
#               texto del botón: Ver o cancelar mi cita
#     ws_cita_recordatorio
#       Cuerpo: Hola {{1}}, te recordamos tu hora en WS Style: {{2}} con {{3}}, {{4}} a las {{5}}.
#               ¿No alcanzas a llegar? Cancela desde el link y liberamos la hora.
#       Pie y botón: iguales a la anterior.
#     {{1}} nombre de pila · {{2}} servicio · {{3}} barbero · {{4}} fecha ("lunes 2 de noviembre") · {{5}} hora.
#  8. Para que los recordatorios salgan a tiempo, la API NO puede dormirse (Render free duerme a los
#     ~15 min sin tráfico): un ping cada 10 min a /api/health (p.ej. cron-job.org) o un plan pago.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Opcionales: versión de la Graph API (default v23.0), idioma de las plantillas (default es; Meta no
# tiene es_CL), número que se muestra en el panel ("Conectado · número +56 9 …", no es secreto) y
# WHATSAPP_DRY_RUN=1 para forzar la simulación aunque haya credenciales.
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE_LANG=
WHATSAPP_DISPLAY_NUMBER=
WHATSAPP_DRY_RUN=

# ─── Comprobantes de la seña por transferencia (SPEC-56). NUNCA van a Mongo.
# fs = disco local (solo desarrollo: el disco de Render se borra al reiniciar).
# s3 = almacenamiento de objetos compatible con S3. Producción: Cloudflare R2, bucket PRIVADO
#      `wstyle-receipts` (sin acceso público). En producción (NODE_ENV=production) la seña no se
#      puede encender si no está configurado el driver s3.
RECEIPTS_STORAGE=fs
# Opcional con fs (por defecto server/uploads/receipts, ignorado en git).
RECEIPTS_DIR=
# Con s3 (R2: https://<account-id>.r2.cloudflarestorage.com y región auto). Secretos: sin valores acá.
S3_ENDPOINT=
S3_BUCKET=wstyle-receipts
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Espejo WS: clave del proyecto OpenAI de la barbería. Vacía desactiva las ediciones pagadas.
WS_MIRROR_OPENAI_KEY=
