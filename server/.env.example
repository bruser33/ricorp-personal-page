PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/pagina_personal
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://bruser33.github.io

# Envío de correo del formulario de contacto (Resend).
# Sin RESEND_API_KEY el endpoint corre en modo dry-run: loguea el envío y responde
# { ok: true, dryRun: true } sin mandar nada. NUNCA commitear una key real.
RESEND_API_KEY=
CONTACT_TO=pedro.luis.rico43@gmail.com
# Remitente: tiene que ser un dominio verificado en Resend.
# `onboarding@resend.dev` funciona sin verificar, pero solo entrega al dueño de la cuenta.
CONTACT_FROM=RICORP <onboarding@resend.dev>

# ─── Agenda y cuentas de WS Style (SPEC-32) ─────────────────────────────────
# Mongo como REPLICA SET de un nodo (las reservas usan transacciones):
#   mongod --replSet rs0 --port 27017 --dbpath <dir>  +  mongosh --eval 'rs.initiate()'
#   MONGO_URI=mongodb://localhost:27017/pagina_personal?replicaSet=rs0
# Tests (`npm test`): BD real separada, nunca la de desarrollo.
MONGO_TEST_URI=mongodb://localhost:27017/wstyle_test?replicaSet=rs0
# URL pública del front (links de los correos y vuelta de Facebook). Local: el MISMO host
# que la API (localhost con localhost; 127.0.0.1 es otro sitio y la cookie no viaja).
FRONT_URL=http://localhost:5173
# Firma del `state` de OAuth. Cualquier texto largo y aleatorio.
AUTH_SECRET=
# 1 = no envía correos de la agenda (los loguea). Útil en desarrollo aunque haya RESEND_API_KEY.
MAIL_DRY_RUN=
MAIL_FROM=WS Style <onboarding@resend.dev>
# Cookie de sesión: en producción COOKIE_SECURE=1. Si la API NO está en un subdominio
# propio (api.ricorp.cl) sino en *.onrender.com, hace falta COOKIE_SAMESITE=None (cookie de
# terceros: Safari la bloquea). Recomendado: api.ricorp.cl + SameSite=Lax.
COOKIE_SECURE=
COOKIE_SAMESITE=Lax

# Facebook Login (RN-24 de SPEC-32 y registro de barberos de SPEC-33). App de Meta en modo
# desarrollo: solo administradores/testers. Sin estas tres variables el botón "Continuar con
# Facebook" no aparece (ni en /wstyle/cuenta/ ni en /wstyle/pro/registro/).
# Pasos: developers.facebook.com → Crear app (tipo "Consumidor", cuenta PERSONAL) → producto
# "Inicio de sesión con Facebook" → "URI de redireccionamiento de OAuth válidos" = FB_REDIRECT_URI
# (local: http://localhost:4000/api/auth/facebook/callback, o el PORT que uses) → Roles → Testers
# (agrega la cuenta de prueba) → Configuración básica: copia el identificador y la clave secreta.
FB_APP_ID=
FB_APP_SECRET=
FB_REDIRECT_URI=http://localhost:4000/api/auth/facebook/callback

# Mercado Pago Checkout Pro (SPEC-35). NUNCA se leen ni se escriben desde el panel: solo viven acá
# (y en Render como variables `sync: false`). El panel (/wstyle/admin/configuracion/) muestra si
# están cargadas y el modo: un token que empieza con TEST- = sandbox; APP_USR- = producción.
# Sin MP_ACCESS_TOKEN "Pagar en línea" no aparece en la reserva aunque el admin lo habilite.
#
# Cómo cargarlas (cuenta PERSONAL de Mercado Pago Chile, nunca una cuenta de trabajo):
#  1. https://www.mercadopago.cl/developers/panel/app → "Crear aplicación" → producto Checkout Pro.
#  2. En la aplicación → "Cuentas de prueba": crea un usuario VENDEDOR y uno COMPRADOR (país Chile).
#  3. Entra a Developers con el vendedor de prueba → su aplicación → credenciales del usuario de
#     prueba → copia el Access Token aquí.
#  4. "Webhooks" (Notificaciones) → modo prueba → URL = <túnel>/api/payments/mp/webhook, evento
#     "Pagos" → guarda y copia la "Clave secreta" a MP_WEBHOOK_SECRET.
#  5. Túnel local (Mercado Pago no llega a localhost):
#       cloudflared tunnel --url http://localhost:4000   (o: ngrok http 4000)
#     y pon esa URL https en MP_NOTIFICATION_URL (con la ruta /api/payments/mp/webhook).
#  6. Reinicia el server (npm run dev) y habilita "Pagar en línea" en el panel → Configuración.
#  Sin túnel también funciona: la página de la cita y la conciliación (cada 5 min) consultan a
#  Mercado Pago por la referencia de la cita.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# URL completa del webhook (opcional). Si no está: API_PUBLIC_URL + /api/payments/mp/webhook.
# Solo se envía a Mercado Pago si es https (localhost no sirve).
MP_NOTIFICATION_URL=
# Front público para las back_urls del checkout (vuelta a /wstyle/cita/?id=…). Default: FRONT_URL.
# Con http (localhost) no se envía auto_return: Mercado Pago lo exige con https; el comprador
# vuelve con el botón "Volver al sitio".
PUBLIC_SITE_URL=http://localhost:5173
# URL pública de esta API (producción: la de Render o api.ricorp.cl).
API_PUBLIC_URL=

# Super admin (SPEC-34 RN-01). Al arrancar (o con `npm run seed:admin`), si NO existe ningún
# super admin se crea uno con este correo y contraseña (hasheada; mínimo 8 caracteres con letras
# y números). Si ya existe uno, no se crea otro ni se cambia su contraseña. Sin estas variables
# no se crea nada y /wstyle/admin/ muestra "Panel no configurado".
# SUPERADMIN_EMAIL también recibe los avisos "Nuevo barbero por aprobar" (varios separados por
# coma; la cuenta se crea con el primero). Cambia la contraseña en el panel después del 1.er ingreso.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
